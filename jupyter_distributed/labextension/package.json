{
  "name": "jupyter-distributed",
  "version": "0.1.0",
  "description": "Jupyter Distributed controls and rank-aware output rendering for SPMD kernels",
  "license": "MIT",
  "author": "Jupyter Distributed contributors",
  "files": [
    "lib/**/*.{js,js.map,d.ts,tsbuildinfo}",
    "style/**/*.css"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:lib": "tsc",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build . --development True",
    "clean": "jlpm clean:lib && jlpm clean:labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyter_distributed/labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "@jupyterlab/coreutils": "^6.6.3",
    "@jupyterlab/debugger": "^4.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0",
    "@jupyterlab/rendermime-interfaces": "^3.8.0",
    "@jupyterlab/services": "^7.6.3",
    "@lumino/disposable": "^2.1.0",
    "@lumino/signaling": "^2.1.0",
    "@lumino/widgets": "^2.4.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyter_distributed/labextension",
    "_build": {
      "load": "static/remoteEntry.e7d8aa6e9634a766b60a.js",
      "extension": "./extension",
      "style": "./style"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
